USE_MOCK_DATA=1
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
# research (default): Yahoo chart prices + local-CIK SEC companyfacts
# yahoo: original yfinance scrape
# MARKET_DATA_PROVIDER=research
# Optional second sources used only when SEC has no facts for a ticker:
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# Point Playwright at a running app or Hugging Face Space instead of launching locally:
# BASE_URL=https://YOUR-SPACE.hf.space
